# ============================================================
# BHUMI SEVA KENDRA - Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to version control

# ============================================================
# SUPABASE
# ============================================================
# Get these from your Supabase project settings
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Service role key (NEVER expose to client)
# Only use in server-side code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# RAZORPAY
# ============================================================
# Get these from Razorpay Dashboard
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Webhook secret (configure in Razorpay Dashboard)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ============================================================
# WHATSAPP BUSINESS API (Optional)
# ============================================================
# Get these from Meta Business Suite
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id

# ============================================================
# EMAIL SERVICE (Optional)
# ============================================================
# For Resend, SendGrid, or similar
EMAIL_PROVIDER_API_KEY=your_email_api_key
EMAIL_FROM_ADDRESS=noreply@bhumisevakendra.in

# ============================================================
# APPLICATION
# ============================================================
VITE_APP_URL=https://bhumisevakendra.in
VITE_DEMO_MODE=false

# ============================================================
# ANALYTICS (Optional)
# ============================================================
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_META_PIXEL_ID=XXXXXXXXXXXXXXXX

# ============================================================
# SECURITY
# ============================================================
# For OTP hashing
OTP_SECRET=your-otp-secret-key

# ============================================================
# DATA RETENTION (Days)
# ============================================================
DOCUMENT_RETENTION_DAYS=365
REPORT_RETENTION_DAYS=730
